# PostgreSQL
DATABASE_URL=postgres://postgres:password@localhost:5432/cheatai
# Длинная случайная строка: openssl rand -hex 32
PAYLOAD_SECRET=change-me
# Публичный адрес сайта без слеша в конце
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# true — staging: показывать черновики и закрыть сайт от индексации
DEMO_MODE=true
# true — не запускать фоновые задачи (отложенная публикация) в этом процессе
DISABLE_JOBS=false
